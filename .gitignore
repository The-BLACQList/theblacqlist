# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local
# .env.example is intentionally NOT excluded — it should be committed

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# BLACQList Management & Operations bundle (local-only, never deployed).
# The bundle runs the product day-to-day; it is intentionally not committed.
# NOTE: lib/meta/ and scripts/meta/ are real app code and ARE committed.
.claude/
/CLAUDE.md
/docs/blacqlist/ops/

# Supabase CLI local state (per-machine link/version cache, not shared config).
supabase/.temp/

# Local-only test fixtures used during manual QA drives.
testassets/

# Unoptimized source frames staged for selection (~159 MB of PNGs). The chosen
# frames ship as optimized WebP under public/images/{cities,editorial}/; these
# originals must never enter the repo or the Vercel build context — everything
# under public/ is uploaded on every build, and committing them would undo the
# 68 MB → 1.5 MB reduction from PR #20.
# Both directories were moved out of the repo on 2026-08-09 to
# ../blacqlist-image-archive/ (founder go-ahead), so nothing matches these paths
# today. The entries stay as a standing guard: if a copy is ever dropped back
# into public/ for a second selection pass, it cannot be committed by accident.
public/images/BL-image-sourcing/
public/images/city-images/
