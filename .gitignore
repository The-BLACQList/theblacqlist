# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local
# .env.example is intentionally NOT excluded — it should be committed

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# BLACQList Management & Operations bundle (local-only, never deployed).
# The bundle runs the product day-to-day; it is intentionally not committed.
# NOTE: lib/meta/ and scripts/meta/ are real app code and ARE committed.
.claude/
/CLAUDE.md
/docs/blacqlist/ops/

# Supabase CLI local state (per-machine link/version cache, not shared config).
supabase/.temp/

# Local-only test fixtures used during manual QA drives.
testassets/
