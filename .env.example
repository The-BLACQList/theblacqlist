# Copy this file to .env.local and fill in values.
# Never commit .env.local to version control.

# ─── Supabase (public) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Supabase (server-only) ──────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=
AUTH_SECRET=

# ─── App Config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# The canonical public URL. Used by sitemap.ts, robots.ts, and OG tags.
# Set to https://theblacqlist.com in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Coming-soon gate (pre-launch) ────────────────────────────────────────────
# When COMING_SOON_MODE=true, the public is redirected to /coming-soon. Visit
# /?preview=<token> once to bypass (sets a cookie); an authenticated session also
# bypasses. Flip to false (or unset) + redeploy to open the full site at launch.
# BYPASS_TOKEN is a secret — set a long random value; never commit a real one.
COMING_SOON_MODE=false
COMING_SOON_BYPASS_TOKEN=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Keys from Stripe Dashboard -> Developers -> API keys
# Use TEST keys locally; LIVE keys in production only
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook secret: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ─── Sentry ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# ─── Meta Graph API (Instagram + Facebook) — ops social tooling ──────────────
# Used by lib/meta/ and scripts/meta/* (social-listening + social-content agents).
# One-time setup: docs/blacqlist/ops/runbooks/meta-setup.md
# App ID + Secret are only needed to run scripts/meta/exchange-token.ts.
META_APP_ID=
META_APP_SECRET=
# The Facebook Page ID and the linked Instagram Business/Creator account ID.
META_PAGE_ID=
META_IG_BUSINESS_ID=
# Long-lived Page access token (from exchange-token.ts). Secret — never commit.
META_PAGE_ACCESS_TOKEN=
# Graph API version (optional; defaults to v22.0).
META_GRAPH_VERSION=v22.0

# ─── Coming-soon rate limiter ────────────────────────────────────────────────
# Salt for the pseudonymized client IP stored by the /coming-soon capture
# throttle (lib/actions/subscribers/subscribeLaunch.ts → launch_subscribe_attempts).
# A bare sha256 of an IP is trivially reversible — the whole IPv4 space is only
# 4 billion hashes — so this salt is what makes the stored digest non-identifying.
# Any long random string. If unset, the limit is STILL enforced with an unsalted
# hash; only the pseudonymization strength degrades.
SUBSCRIBE_RATE_LIMIT_SALT=
