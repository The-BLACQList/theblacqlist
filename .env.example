# Copy this file to .env.local and fill in values.
# Never commit .env.local to version control.

# ─── Supabase (public) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Supabase (server-only) ──────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=
AUTH_SECRET=

# ─── App Config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
# The canonical public URL. Used by sitemap.ts, robots.ts, and OG tags.
# Set to https://theblacqlist.com in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Keys from Stripe Dashboard -> Developers -> API keys
# Use TEST keys locally; LIVE keys in production only
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook secret: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ─── Sentry ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
